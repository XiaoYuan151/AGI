{
  "name": "@local/dsh-agi",
  "version": "0.4.0",
  "description": "DeepSeek Harness plugin integrating Google Antigravity ACP (agy acp) as a native LLM provider with a plugin detail GUI for account login and multi-account management.",
  "type": "module",
  "main": "src/index.mjs",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agy",
    "acp",
    "antigravity",
    "llm"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./src/index.mjs",
    "./adapter": "./src/adapter.mjs",
    "./client": "./src/client/index.js",
    "./gui-service": "./src/gui-service.mjs",
    "./gui-server": "./src/gui-server.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "scripts",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0",
    "@deepseek-ai/dsh-commands": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    }
  }
}
